# Ignore contents of runtime directories but keep the directories themselves
old/*
output/*
new/*

# But allow empty placeholder files in these directories (if needed)
!old/.gitkeep
!output/.gitkeep
!new/.gitkeep

# Ignore Python bytecode
__pycache__/
*.pyc

# Ignore log files
*.log

# Ignore environment files (contain API keys, do not commit)
.env
.env.local
.env.*.local

# Keep .env.example as a template for others
!.env.example

# Ignore IDE files
.vscode/
.idea/
