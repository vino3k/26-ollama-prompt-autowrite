# Ignore contents of runtime directories but keep the directories themselves
old/*
output/*
new/*

# Logs: ignore log files but keep directory + .gitkeep
logs/*.log
logs/*.lock
logs/monitor.log
logs/.monitor.lock

# But allow empty placeholder files in these directories (if needed)
!old/.gitkeep
!output/.gitkeep
!new/.gitkeep
!logs/.gitkeep

# Ignore Python bytecode
__pycache__/
*.pyc

# Ignore log files
*.log

# Ignore environment files (contain API keys, do not commit)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Keep .env.example as a template for others
!.env.example
!.env.example.docker

# Ignore keys & certificates (do not commit secrets)
*.pem
*.key
*.crt
*.pfx
id_rsa
id_rsa.pub

# Ignore local private configs
*local.config.json
config.local.yaml
settings.local.yml

# Ignore IDE files
.vscode/
.idea/

# Ignore Windows system diagnostic dumps
dxdiag.txt
*.dmp

# Ignore Docker build artifacts
docker-compose.override.yml

# Ignore Docker runtime data mounts (processed articles, outputs)
files/
