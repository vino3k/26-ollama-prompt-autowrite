# LLM 提供方：ollama（本地，默认） / agnes（云端 API）
# 修改后需要重启 process_articles.py / main.py 才会生效
LLM_PROVIDER=agnes

# === Ollama 配置（仅参考，一般无需修改） ===
# OLLAMA_API_URL=http://192.168.2.111:11434/api/generate
# OLLAMA_MODEL=qwen3.5:latest

# === Agnes-2.0-Flash 配置 ===
# 当 LLM_PROVIDER=agnes 时生效
# 在 https://apihub.agnes-ai.cn/ 申请 API Key
AGNES_API_KEY=sk-请在这里填入你的Agnes-API-Key
