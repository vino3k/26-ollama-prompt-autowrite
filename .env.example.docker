# Docker 部署使用示例
# 复制此文件为 .env 并填入实际值
# cp .env.example.docker .env

# ============================================================
# 局域网（192.168.2.x）部署
# - Git 服务器:  192.168.2.27
# - Ollama 服务: 192.168.2.111:11434（局域网内）
# ============================================================

# ===== LLM 提供方选择 =====
# ollama：使用局域网 Ollama（推荐，访问 192.168.2.111）
# agnes：  使用云端 Agnes-2.0-Flash API
LLM_PROVIDER=agnes

# ===== Ollama 配置（LLM_PROVIDER=ollama 时生效） =====
# 容器内访问宿主机 Ollama 的地址
# 注意：宿主机 Ollama 在 192.168.2.111，Docker 容器内可通过：
#   1. host.docker.internal（Docker Desktop Mac/Win 自动支持）
#   2. host-gateway（Linux 容器支持）
#   3. 局域网 IP 直接访问（192.168.2.111）
# 建议直接用局域网 IP，最稳
OLLAMA_HOST=192.168.2.111
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:latest

# ===== Agnes 配置（LLM_PROVIDER=agnes 时生效） =====
# 在 https://apihub.agnes-ai.com/ 申请 API Key
AGNES_API_KEY=sk-your-agnes-api-key
