# Docker 部署使用示例
# 复制此文件为 .env 并填入实际值
# cp .env.example.docker .env

# ===== LLM 提供方选择 =====
# ollama：使用宿主机本地 Ollama（需要 OLLAMA_HOST 可达）
# agnes：  使用云端 Agnes-2.0-Flash API
LLM_PROVIDER=ollama

# ===== Ollama 配置（LLM_PROVIDER=ollama 时生效） =====
# 容器内访问宿主机 Ollama 的地址
# Linux 下一般用 host.docker.internal（需要 extra_hosts 配合 host-gateway）
# 或写宿主机局域网 IP
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# ===== Agnes 配置（LLM_PROVIDER=agnes 时生效） =====
# 在 https://apihub.agnes-ai.com/ 申请 API Key
AGNES_API_KEY=sk-your-agnes-api-key
